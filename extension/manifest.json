{
  "manifest_version": 3,
  "name": "Ledgerly",
  "version": "1.0.0",
  "description": "Self-custodial XRP Ledger wallet. Your keys are generated and stored on your device only.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ledgerly",
    "default_icon": { "128": "icon128.png" }
  },
  "icons": { "16": "icon128.png", "48": "icon128.png", "128": "icon128.png" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}

# Publishable coordinates for your Supabase project. Use the same project on both sides.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Server-only credentials: configure securely in Vercel or your ignored .env.local.
SUPABASE_SERVICE_ROLE_KEY=""

# Public activity counter. Empty turns reporting off.
# Production deployments of ledgerlywallet.com keep the live endpoint without these.
# Dev, preview, and local builds must not set these to the production site.
VITE_ACTIVITY_URL=""
ACTIVITY_URL=""

# XRPL.to: server-only thumbnail key. Enable redistribution only after written permission.
XRPL_TO_API_KEY=""
XRPL_TO_REDISTRIBUTION_APPROVED="false"

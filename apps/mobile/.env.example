EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional first-party HTTPS origin; configure only after provider permission and server key setup.
EXPO_PUBLIC_MARKET_API_ORIGIN=

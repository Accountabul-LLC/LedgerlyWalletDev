# Optional approved first-party HTTPS market backend. Leave unset for anonymous public prices.
# Configure XRPL_TO_API_KEY only on the backend; never put a provider key in this file.
EXPO_PUBLIC_MARKET_API_ORIGIN=""

# Supabase coordinates. Set per EAS environment (eas env) or in an ignored .env.local. Never commit values.
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
